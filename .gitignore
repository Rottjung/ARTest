# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Autogenerated IDE/project files
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Downloaded package cache (regenerable)
ContentPackages/

# OS / misc
.DS_Store
sysinfo.txt
crashlytics-build.properties

# Packages lockfile - keep tracked for reproducible resolves
!Packages/packages-lock.json
.localssl/
Builds/
zcv.log

# GitHub Pages sites (possibly multiple, one per scene, in subfolders) - the
# generic [Bb]uild/ rule above also matches these, so explicitly un-ignore them
# (these are real published sites, not regenerable build output)
!docs/**/Build/
!docs/**/Build/*
